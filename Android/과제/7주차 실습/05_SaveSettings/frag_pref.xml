<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <CheckBoxPreference
        android:key="check"
        android:title="진동여부"
        android:defaultValue="false"
        android:summary="체크하면 진동설정" />

    <SwitchPreferenceCompat
        android:key="notifications"
        android:title="알림 활성화" />

    <EditTextPreference
        android:key="volume"
        android:title="음량선택"
        android:defaultValue="20"
        android:summary="음량을 선택하시오" />

    <ListPreference
        android:key="sex"
        android:title="성별"
        android:defaultValue="1"
        android:entries="@array/sex"
        android:entryValues="@array/sex" />

    <MultiSelectListPreference
        android:key="region"
        android:title="선호 지역"
        android:defaultValue="@array/region"
        android:entries="@array/region"
        android:entryValues="@array/region" />

</PreferenceScreen>